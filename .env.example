# ── Required ──────────────────────────────────────────────────────────────
# PostgreSQL connection string (on Liara: from the database's connection page).
DATABASE_URL=postgres://user:password@localhost:5432/avatar
# DATABASE_SSL=false   # only for a local database without TLS

# Random strings, at least 32 characters each: openssl rand -hex 32
SESSION_SECRET=
# Encrypts API keys stored from the admin panel. Changing it makes every
# stored key unreadable (they must be re-entered). Keep a safe copy.
ENCRYPTION_KEY=

# ── First admin (optional) ────────────────────────────────────────────────
# If no admin exists at startup, one is created from these. Remove the
# password afterwards. Alternative: npm run admin:create
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Development only ──────────────────────────────────────────────────────
# Enables the cost-free "mock" provider for testing the voice loop.
# ENABLE_MOCK_PROVIDERS=1
